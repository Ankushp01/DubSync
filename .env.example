# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=dubsync

# Resend Email Configuration (Testing & Production)
# Testing with onboarding@resend.dev is restricted to the Resend account owner's email address.
# A verified custom domain is required for arbitrary recipient delivery.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000

# Security & Session Settings
JWT_SECRET_KEY=change-in-production-to-at-least-32-characters-secure-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
